# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Prose is never hard-wrapped here: one paragraph is one line, however long.
# Editors that reflow at a column will otherwise reintroduce it silently.
max_line_length = off
